version: "3"
services:
  database:
    container_name: database
    build: './oracle-db'
    #image: 'container-registry.oracle.com/database/free:latest'
    restart: unless-stopped
    networks:
      - default
    ports:
      - '1521:1521'
    hostname: database
    environment:
      - ORACLE_PWD=Smartway1
    volumes:
      # - ./oracle-db/data_testxliff:/opt/oracle/oradata
      - ./oracle-db/data:/opt/oracle/oradata
      #- ./oracle-db/setup_scripts:/opt/oracle/scripts/setup
    healthcheck:
      test: ["CMD", "/opt/oracle/healthcheck.sh"]
      start_period: 60s
      interval: 30s
      timeout: 10s
      retries: 100

  maximo:
    container_name: maximo
    build:
      context: './maximo'
      dockerfile: Dockerfile.aviation.mr
    restart: "no"
    depends_on:
      database:
        condition: service_healthy
    networks:
      - default
    ports:
      - '9080:9080'
      - '7777:7777'
    environment:
      - MXE_DB_URL=jdbc:oracle:thin:@database:1521/freepdb1
      - MXE_DB_SCHEMAOWNER=maximo
      - MXE_DB_DRIVER=oracle.jdbc.driver.OracleDriver
      - MXE_DB_USER=maximo
      - MXE_DB_PASSWORD=maximo
      - MAXIMO_DATAFILE=maxdemo
      # - SEC_TLS_TRUSTDEFAULTCERTS=true
      - OSM_TRUSTSTORE_PASSWORD=password1
      #- JVM_ARGS="-agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:7777"
    volumes:
      - ./doclinks:/opt/IBM/doclinks
      - ./customization_archives:/config/customization_archives
      - ./certificatmgr:/config/certificatmgr
    extra_hosts:
      # - "my-bucket.s3mock:172.18.0.5"  # IP de s3mock container
      - "my-bucket.s3.eu-west-3.localstack:172.18.0.2"  # IP de s3mock container
  
  # bdi:
  #   container_name: bdi
  #   hostname: bdi
  #   image: cp.icr.io/cp/manage/bdi@sha256:fdd669e4fdbde39c5e80efe5ff700515f8a7317e5b971ad51c3635d5347a7749
  #   restart: unless-stopped
  #   depends_on:
  #     database:
  #       condition: service_healthy
  #   networks:
  #     - default
  #   ports:
  #     - '9081:9080'
  #   environment:
  #     - BDI_LOG_LEVEL=INFO
  #     - BDI_XDB_CONNECT=jdbc:oracle:thin:@database:1521/freepdb1
  #     - BDI_XDB_SCHEMA_NAME=maximo
  #     - BDI_XDB_USER=maximo
  #     - BDI_XDB_PASSWORD=maximo
  #     - BDI_HOME=/opt/was/liberty/wlp/usr/shared/resources
 
  kafka:
    image: apache/kafka:latest
    container_name: kafka
    hostname: kafka
    depends_on:
      database:
        condition: service_healthy
    networks:
      - default
    environment:
      KAFKA_NODE_ID: 1
      KAFKA_PROCESS_ROLES: broker,controller
      KAFKA_LISTENERS: PLAINTEXT://kafka:9092,CONTROLLER://localhost:9093
      KAFKA_ADVERTISED_LISTENERS: PLAINTEXT://kafka:9092
      KAFKA_CONTROLLER_LISTENER_NAMES: CONTROLLER
      KAFKA_LISTENER_SECURITY_PROTOCOL_MAP: CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT
      KAFKA_CONTROLLER_QUORUM_VOTERS: 1@localhost:9093
      KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR: 1
      KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR: 1
      KAFKA_TRANSACTION_STATE_LOG_MIN_ISR: 1
      KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS: 0
      KAFKA_NUM_PARTITIONS: 3
    ports:
      - 9092:9092
      - 9093:9093

  localstack:
    image: localstack/localstack:4.14.0
    container_name: s3.eu-west-3.localstack
    ports:
      - "4566:4566"      # Port principal de LocalStack
      - "4571:4571"      # Port S3 (optionnel)
    environment:
      # - SERVICES=s3
      - DEBUG=1
      - HOSTNAME_EXTERNAL=s3.eu-west-3.localstack
    volumes:
      - "./localstack/my-bucket:/var/lib/localstack/tmp/init-my-bucket" # ce volume est nécessaire pour initialiser la bucket à chaque démarrage, car la version free de localstack ne supporte pas la persistance
      - "./localstack/init:/etc/localstack/init/ready.d/"