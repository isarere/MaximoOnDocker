# For more information on configuration, see:
#   * Official English Documentation: http://nginx.org/en/docs/
#   * Official Russian Documentation: http://nginx.org/ru/docs/

# user wiotp;
worker_processes auto;
error_log /var/log/nginx/error.log;
pid /tmp/writeable/run/nginx.pid;

# Load dynamic modules. See /usr/share/doc/nginx/README.dynamic.
include /usr/share/nginx/modules/*.conf;

events {
    worker_connections 1024;
}

http {
    log_format  main  '${SCAPE}remote_addr - ${SCAPE}remote_user [${SCAPE}time_local] "${SCAPE}request" '
                      '${SCAPE}status ${SCAPE}body_bytes_sent "${SCAPE}http_referer" '
                      '"${SCAPE}http_user_agent" "${SCAPE}http_x_forwarded_for"';

    access_log  /var/log/nginx/access.log  main;

    server_tokens       off;
    sendfile            on;
    tcp_nopush          on;
    tcp_nodelay         on;
    keepalive_timeout   65;
    types_hash_max_size 2048;

    include             /etc/nginx/mime.types;
    default_type        application/octet-stream;

    # Load modular configuration files from the /etc/nginx/conf.d directory.
    # See http://nginx.org/en/docs/ngx_core_module.html#include
    # for more information.
    include /etc/nginx/conf.d/*.conf;
    limit_req_zone ${SCAPE}binary_remote_addr zone=ip:10m rate=100r/s;

    server {
        listen 9443 ssl http2;
        ssl_certificate /etc/mcp-local-tls/tls.crt;
        ssl_certificate_key /etc/mcp-local-tls/tls.key;
        ssl_session_cache shared:SSL:1m;
        ssl_session_timeout  10m;
        ssl_ciphers PROFILE=SYSTEM;
        ssl_prefer_server_ciphers on;
        server_name  _;
        root /usr/share/nginx/html;

        ssl_client_certificate /etc/mas/certs/ca.crt;
        ssl_verify_client optional;

        # Load configuration files for the default server block.
        # include /etc/nginx/default.d/*.conf;
        set ${SCAPE}cors "";

        if (${SCAPE}http_origin ~* (.*\.${DOMAIN_NAME}(:[0-9]+)?${SCAPE})) {
            set ${SCAPE}cors "true";
        }

        # Path-based routing: /{appId}/{workspaceId}/mcp -> /mcp
        # This location block must come BEFORE the generic / location
        location ~ ^/[^/]+/[^/]+/mcp(/.*)?${SCAPE} {
            limit_req zone=ip burst=12 nodelay;
            limit_req_status 429;

            # Rewrite /{appId}/{workspaceId}/mcp/xyz to /mcp/xyz
            rewrite ^/[^/]+/[^/]+/mcp(.*)${SCAPE} /mcp${SCAPE}1 break;

            if (${SCAPE}cors = "true") {
                add_header 'Access-Control-Allow-Origin' "${SCAPE}http_origin" always;
                add_header 'Access-Control-Allow-Methods' 'GET, POST, OPTIONS, DELETE, PUT, PATCH' always;
                add_header 'Access-Control-Allow-Credentials' 'true' always;
                add_header 'Access-Control-Allow-Headers' 'Authorization,Accept,Origin,DNT,X-CustomHeader,Keep-Alive,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Content-Range,Range' always;
            }

            proxy_pass http://127.0.0.1:8080;
            proxy_redirect     off;

            proxy_set_header   Host                 ${SCAPE}host;
            proxy_set_header   X-Real-IP            ${SCAPE}remote_addr;
            proxy_set_header   X-Forwarded-For      ${SCAPE}proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Proto    ${SCAPE}scheme;
            proxy_set_header   X-Forwarded-Host     ${SCAPE}host;
            proxy_set_header   X-Forwarded-Port     ${SCAPE}server_port;
        }

        location / {
            limit_req zone=ip burst=12 nodelay;
            limit_req_status 429;

            if (${SCAPE}cors = "true") {
                add_header 'Access-Control-Allow-Origin' "${SCAPE}http_origin" always;
                add_header 'Access-Control-Allow-Methods' 'GET, POST, OPTIONS, DELETE, PUT, PATCH' always;
                add_header 'Access-Control-Allow-Credentials' 'true' always;
                add_header 'Access-Control-Allow-Headers' 'Authorization,Accept,Origin,DNT,X-CustomHeader,Keep-Alive,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Content-Range,Range' always;
            }
            proxy_pass http://127.0.0.1:8080;
            proxy_redirect     off;

            proxy_set_header   Host                 ${SCAPE}host;
            proxy_set_header   X-Real-IP            ${SCAPE}remote_addr;
            proxy_set_header   X-Forwarded-For      ${SCAPE}proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Proto    ${SCAPE}scheme;
        }

        # error_page 404 /404.html;
        #     location = /40x.html {
        # }

        # error_page 500 502 503 504 /50x.html;
        #     location = /50x.html {
        # }
    }
}